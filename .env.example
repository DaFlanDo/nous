# Скопируйте в .env и заполните. Используется docker compose и backend.

# MongoDB (пароль для пользователя admin внутри compose)
MONGO_PASSWORD=

# Обязательные секреты backend — сгенерируйте: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=

# ИИ: любой OpenAI-совместимый API. Без ключа работает всё, кроме ассистента
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# AI_REQUESTS_PER_HOUR=60

# Вход через Google (без него остаётся вход по email и паролю)
GOOGLE_CLIENT_ID=

# «Попробовать без регистрации»: каждому посетителю своя песочница на 24 часа.
# В docker compose включено по умолчанию; false — обычное приложение
# DEMO_MODE=true

# Откуда разрешены запросы к API, через запятую
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Адрес API для фронта (подставляется при сборке)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
